rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'zeeshanjan21khankoko@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Entity Validation Blueprints ---
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'admin_level', 'created_at']) &&
        data.keys().hasOnly(['uid', 'email', 'admin_level', 'created_at']) &&
        data.uid is string && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.admin_level in ['super_admin', 'moderator'] &&
        data.created_at is timestamp;
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'player_id', 'username', 'points', 'updated_at']) &&
        data.keys().hasOnly(['uid', 'player_id', 'username', 'avatar_url', 'points', 'updated_at']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.player_id is string && data.player_id.size() >= 3 && data.player_id.size() <= 32 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        (!('avatar_url' in data) || (data.avatar_url is string && data.avatar_url.size() <= 512)) &&
        data.points is int && data.points >= 0 &&
        data.updated_at is timestamp;
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'username', 'player_id', 'role', 'created_at', 'updated_at']) &&
        data.keys().hasOnly([
          'uid', 'sqlite_id', 'firebase_uid', 'email', 'username', 'player_id', 'phone', 'avatar_url',
          'role', 'is_blocked', 'wallet_balance', 'pending_withdrawal', 'total_deposited',
          'total_withdrawn', 'total_won', 'matches_played', 'wins', 'kills', 'points',
          'last_lucky_draw_pkt', 'last_lucky_draw_at', 'created_at', 'updated_at'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        (!('sqlite_id' in data) || (data.sqlite_id is int && data.sqlite_id >= 1)) &&
        (!('firebase_uid' in data) || (data.firebase_uid is string && data.firebase_uid.size() <= 128)) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        data.player_id is string && data.player_id.size() >= 3 && data.player_id.size() <= 32 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('avatar_url' in data) || (data.avatar_url is string && data.avatar_url.size() <= 512)) &&
        data.role in ['player', 'admin'] &&
        (!('is_blocked' in data) || data.is_blocked in [0, 1]) &&
        (!('wallet_balance' in data) || (data.wallet_balance is int && data.wallet_balance >= 0)) &&
        (!('pending_withdrawal' in data) || (data.pending_withdrawal is int && data.pending_withdrawal >= 0)) &&
        (!('total_deposited' in data) || (data.total_deposited is int && data.total_deposited >= 0)) &&
        (!('total_withdrawn' in data) || (data.total_withdrawn is int && data.total_withdrawn >= 0)) &&
        (!('total_won' in data) || (data.total_won is int && data.total_won >= 0)) &&
        (!('matches_played' in data) || (data.matches_played is int && data.matches_played >= 0)) &&
        (!('wins' in data) || (data.wins is int && data.wins >= 0)) &&
        (!('kills' in data) || (data.kills is int && data.kills >= 0)) &&
        (!('points' in data) || (data.points is int && data.points >= 0)) &&
        (!('last_lucky_draw_pkt' in data) || (data.last_lucky_draw_pkt is string && data.last_lucky_draw_pkt.size() <= 16)) &&
        (!('last_lucky_draw_at' in data) || data.last_lucky_draw_at is timestamp) &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidTournament(data) {
      return data.keys().hasAll([
          'id', 'title', 'game_name', 'mode', 'entry_fee', 'prize_pool',
          'prize_1st', 'prize_2nd', 'prize_3rd', 'prize_4th', 'prize_5th',
          'max_slots', 'filled_slots', 'match_time', 'end_time', 'status',
          'banner_url', 'rules', 'winners', 'created_by_uid', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'game_name', 'mode', 'entry_fee', 'prize_pool',
          'prize_1st', 'prize_2nd', 'prize_3rd', 'prize_4th', 'prize_5th',
          'max_slots', 'filled_slots', 'match_time', 'end_time', 'status',
          'banner_url', 'rules', 'winners', 'created_by_uid', 'created_at', 'updated_at'
        ]) &&
        data.id is int && data.id >= 1 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.game_name is string && data.game_name.size() >= 2 && data.game_name.size() <= 64 &&
        data.mode in ['Battle Royale', 'Clash Squad', 'Lone Wolf'] &&
        data.entry_fee is int && data.entry_fee >= 0 &&
        data.prize_pool is int && data.prize_pool >= 0 &&
        data.prize_1st is int && data.prize_1st >= 0 &&
        data.prize_2nd is int && data.prize_2nd >= 0 &&
        data.prize_3rd is int && data.prize_3rd >= 0 &&
        data.prize_4th is int && data.prize_4th >= 0 &&
        data.prize_5th is int && data.prize_5th >= 0 &&
        data.max_slots is int && data.max_slots >= 2 && data.max_slots <= 500 &&
        data.filled_slots is int && data.filled_slots >= 0 && data.filled_slots <= data.max_slots &&
        data.match_time is string && data.match_time.size() >= 10 && data.match_time.size() <= 64 &&
        data.end_time is string && data.end_time.size() <= 64 &&
        data.status in ['upcoming', 'live', 'completed', 'cancelled'] &&
        data.banner_url is string && data.banner_url.size() <= 512 &&
        data.rules is string && data.rules.size() <= 4000 &&
        data.winners is list && data.winners.size() <= 5 &&
        (data.winners.size() == 0 || data.winners[0] is map) &&
        data.created_by_uid is string && isValidId(data.created_by_uid) &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidTournamentSecret(data) {
      return data.keys().hasAll(['room_id', 'room_pass', 'updated_at']) &&
        data.keys().hasOnly(['room_id', 'room_pass', 'updated_at']) &&
        data.room_id is string && data.room_id.size() <= 64 &&
        data.room_pass is string && data.room_pass.size() <= 64 &&
        data.updated_at is timestamp;
    }

    function isValidTournamentRegistration(data, userId) {
      return data.keys().hasAll(['user_uid', 'player_id', 'in_game_name', 'in_game_id', 'slot_number', 'status', 'registered_at']) &&
        data.keys().hasOnly([
          'tournament_id', 'user_uid', 'sqlite_user_id', 'player_id',
          'username', 'in_game_name', 'in_game_id', 'slot_number', 'status', 'registered_at'
        ]) &&
        (!('tournament_id' in data) || (data.tournament_id is int && data.tournament_id >= 1)) &&
        data.user_uid is string && data.user_uid == userId && isValidId(data.user_uid) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        data.player_id is string && data.player_id.size() >= 3 && data.player_id.size() <= 32 &&
        (!('username' in data) || (data.username is string && data.username.size() <= 32)) &&
        data.in_game_name is string && data.in_game_name.size() >= 1 && data.in_game_name.size() <= 64 &&
        data.in_game_id is string && data.in_game_id.size() >= 1 && data.in_game_id.size() <= 64 &&
        data.slot_number is int && data.slot_number >= 1 && data.slot_number <= 500 &&
        data.status in ['registered', 'disqualified'] &&
        data.registered_at is timestamp;
    }

    function isValidDeposit(data, depositId) {
      return data.keys().hasAll([
          'deposit_key', 'user_uid', 'player_id', 'username', 'email', 'amount',
          'method', 'transaction_ref', 'sender_account', 'status', 'admin_note', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'deposit_key', 'user_uid', 'sqlite_user_id', 'player_id', 'username', 'email',
          'amount', 'method', 'transaction_ref', 'sender_account', 'has_screenshot',
          'screenshot_preview', 'status', 'admin_note', 'tx_code', 'reviewed_at', 'created_at'
        ]) &&
        (!('id' in data) || (data.id is int && data.id >= 1)) &&
        data.deposit_key is string && data.deposit_key == depositId && isValidId(data.deposit_key) &&
        data.user_uid is string && isValidId(data.user_uid) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        data.player_id is string && data.player_id.size() >= 3 && data.player_id.size() <= 32 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.amount is int && data.amount >= 1 && data.amount <= 1000000 &&
        data.method in ['jazzcash', 'easypaisa'] &&
        data.transaction_ref is string && data.transaction_ref.size() >= 4 && data.transaction_ref.size() <= 64 &&
        data.sender_account is string && data.sender_account.size() >= 4 && data.sender_account.size() <= 64 &&
        (!('has_screenshot' in data) || data.has_screenshot is bool) &&
        (!('screenshot_preview' in data) || (data.screenshot_preview is string && data.screenshot_preview.size() <= 450000)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.admin_note is string && data.admin_note.size() <= 250 &&
        (!('tx_code' in data) || (data.tx_code is string && data.tx_code.size() <= 64)) &&
        (!('reviewed_at' in data) || (data.reviewed_at is string && data.reviewed_at.size() <= 64)) &&
        data.created_at is timestamp;
    }

    function isValidWithdrawal(data, withdrawalId) {
      return data.keys().hasAll([
          'withdrawal_key', 'user_uid', 'player_id', 'username', 'email', 'amount',
          'method', 'bank_name', 'account_title', 'account_number', 'status', 'admin_note', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'withdrawal_key', 'user_uid', 'sqlite_user_id', 'player_id', 'username', 'email',
          'amount', 'method', 'bank_name', 'account_title', 'account_number',
          'status', 'admin_note', 'tx_code', 'reviewed_at', 'created_at'
        ]) &&
        (!('id' in data) || (data.id is int && data.id >= 1)) &&
        data.withdrawal_key is string && data.withdrawal_key == withdrawalId && isValidId(data.withdrawal_key) &&
        data.user_uid is string && isValidId(data.user_uid) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        data.player_id is string && data.player_id.size() >= 3 && data.player_id.size() <= 32 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.amount is int && data.amount >= 1 && data.amount <= 1000000 &&
        data.method in ['jazzcash', 'easypaisa', 'bank_account'] &&
        data.bank_name is string && data.bank_name.size() <= 64 &&
        data.account_title is string && data.account_title.size() >= 2 && data.account_title.size() <= 64 &&
        data.account_number is string && data.account_number.size() >= 6 && data.account_number.size() <= 34 &&
        data.status in ['pending', 'approved', 'rejected', 'paid'] &&
        data.admin_note is string && data.admin_note.size() <= 250 &&
        (!('tx_code' in data) || (data.tx_code is string && data.tx_code.size() <= 64)) &&
        (!('reviewed_at' in data) || (data.reviewed_at is string && data.reviewed_at.size() <= 64)) &&
        data.created_at is timestamp;
    }

    function isValidLedgerTransaction(data, txCode) {
      return data.keys().hasAll([
          'tx_code', 'user_uid', 'type', 'amount', 'direction',
          'balance_after', 'status', 'reference_id', 'description', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'tx_code', 'user_uid', 'sqlite_user_id', 'player_id', 'username',
          'type', 'amount', 'direction', 'balance_after', 'status',
          'reference_id', 'description', 'created_at'
        ]) &&
        (!('id' in data) || (data.id is int && data.id >= 1)) &&
        data.tx_code is string && data.tx_code == txCode && data.tx_code.size() >= 4 && data.tx_code.size() <= 64 &&
        isValidId(data.tx_code) &&
        data.user_uid is string && isValidId(data.user_uid) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        (!('player_id' in data) || (data.player_id is string && data.player_id.size() <= 32)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 32)) &&
        data.type in [
          'deposit', 'withdrawal', 'entry_fee', 'prize_win', 'refund',
          'admin_adjustment', 'transfer_out', 'transfer_in', 'lucky_draw'
        ] &&
        data.amount is int && data.amount >= 0 && data.amount <= 10000000 &&
        data.direction in ['credit', 'debit'] &&
        data.balance_after is int && data.balance_after >= 0 &&
        data.status in ['pending', 'approved', 'paid', 'completed', 'rejected'] &&
        data.reference_id is string && data.reference_id.size() <= 64 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        data.created_at is timestamp;
    }

    function isValidLuckyDrawEntry(data, drawKey) {
      return data.keys().hasAll(['user_uid', 'draw_date_pkt', 'prize_amount', 'prize_label', 'created_at']) &&
        data.keys().hasOnly(['user_uid', 'sqlite_user_id', 'draw_date_pkt', 'prize_amount', 'prize_label', 'created_at']) &&
        data.user_uid is string && isValidId(data.user_uid) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        data.draw_date_pkt is string && data.draw_date_pkt.size() == 10 &&
        drawKey == (data.user_uid + '_' + data.draw_date_pkt) &&
        data.prize_amount is int && data.prize_amount >= 0 && data.prize_amount <= 50 &&
        data.prize_label is string && data.prize_label.size() >= 1 && data.prize_label.size() <= 64 &&
        data.created_at is timestamp;
    }

    function isValidTeamRegistration(data, regCode) {
      return data.keys().hasAll([
          'registration_code', 'tournament_id', 'leader_name', 'freefire_uid',
          'whatsapp_number', 'team_name', 'squad_type', 'payment_method', 'payment_ref', 'status', 'created_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'registration_code', 'tournament_id', 'user_uid', 'sqlite_user_id',
          'leader_name', 'freefire_uid', 'whatsapp_number', 'team_name', 'squad_type',
          'teammates', 'payment_method', 'payment_ref', 'status', 'created_at'
        ]) &&
        (!('id' in data) || (data.id is int && data.id >= 1)) &&
        data.registration_code is string && data.registration_code == regCode && isValidId(data.registration_code) &&
        data.tournament_id is int && data.tournament_id >= 1 &&
        (!('user_uid' in data) || (data.user_uid is string && data.user_uid.size() <= 128)) &&
        (!('sqlite_user_id' in data) || (data.sqlite_user_id is int && data.sqlite_user_id >= 1)) &&
        data.leader_name is string && data.leader_name.size() >= 2 && data.leader_name.size() <= 64 &&
        data.freefire_uid is string && data.freefire_uid.size() >= 4 && data.freefire_uid.size() <= 32 &&
        data.whatsapp_number is string && data.whatsapp_number.size() >= 6 && data.whatsapp_number.size() <= 24 &&
        data.team_name is string && data.team_name.size() >= 2 && data.team_name.size() <= 64 &&
        data.squad_type in ['Solo', 'Duo', 'Squad'] &&
        (!('teammates' in data) || (data.teammates is string && data.teammates.size() <= 500)) &&
        data.payment_method in ['free', 'wallet', 'jazzcash', 'easypaisa'] &&
        data.payment_ref is string && data.payment_ref.size() <= 64 &&
        data.status in ['pending', 'confirmed', 'rejected'] &&
        data.created_at is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'content', 'is_pinned', 'created_by_uid', 'created_at']) &&
        data.keys().hasOnly(['id', 'title', 'category', 'content', 'is_pinned', 'created_by_uid', 'created_at']) &&
        data.id is int && data.id >= 1 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 160 &&
        data.category in ['Announcement', 'Match Result', 'Room Alert', 'Rules Update'] &&
        data.content is string && data.content.size() >= 3 && data.content.size() <= 4000 &&
        data.is_pinned in [0, 1] &&
        data.created_by_uid is string && isValidId(data.created_by_uid) &&
        data.created_at is timestamp;
    }

    function isValidAppTournamentPolicy(data) {
      return data.keys().hasAll([
          'auto_creation_disabled', 'manual_admin_only', 'deleted_tournament_ids', 'updated_by_uid', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'auto_creation_disabled', 'manual_admin_only', 'deleted_tournament_ids', 'updated_by_uid', 'updated_at'
        ]) &&
        data.auto_creation_disabled == true &&
        data.manual_admin_only == true &&
        data.deleted_tournament_ids is list && data.deleted_tournament_ids.size() <= 200 &&
        (data.deleted_tournament_ids.size() == 0 || data.deleted_tournament_ids[0] is int) &&
        data.updated_by_uid is string && isValidId(data.updated_by_uid) &&
        data.updated_at is timestamp;
    }

    function isValidAppUserPolicy(data) {
      return data.keys().hasAll([
          'auto_deletion_disabled', 'manual_admin_only_deletion', 'preserve_registrations',
          'deleted_user_ids', 'updated_by_uid', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'auto_deletion_disabled', 'manual_admin_only_deletion', 'preserve_registrations',
          'deleted_user_ids', 'updated_by_uid', 'updated_at'
        ]) &&
        data.auto_deletion_disabled == true &&
        data.manual_admin_only_deletion == true &&
        data.preserve_registrations == true &&
        data.deleted_user_ids is list && data.deleted_user_ids.size() <= 500 &&
        (data.deleted_user_ids.size() == 0 || data.deleted_user_ids[0] is int) &&
        data.updated_by_uid is string && isValidId(data.updated_by_uid) &&
        data.updated_at is timestamp;
    }

    // --- Collection Rules ---

    // Connection probe document for startup SDK verification
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Admin allowlist: only bootstrapped admin can write; owner or admin can read
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(userId) && isValidAdminUser(incoming()) &&
        incoming().uid == userId && incoming().created_at == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(userId) && isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['admin_level', 'email']);
      allow delete: if isBootstrappedAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // Public non-PII profiles
    match /users_public/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) && incoming().updated_at == request.time && (
          (isOwner(userId) && incoming().points == 0) ||
          isAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) && (
          (isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().player_id == existing().player_id &&
            incoming().points == existing().points &&
            incoming().updated_at == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatar_url', 'updated_at'])) ||
          (isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().player_id == existing().player_id &&
            incoming().points >= existing().points &&
            incoming().points <= existing().points + 10 &&
            incoming().updated_at == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['points', 'updated_at'])) ||
          (isAdmin() &&
            incoming().uid == existing().uid &&
            incoming().updated_at == request.time)
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // Private PII-isolated user records & authoritative wallet balances
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        (isVerifiedUser() && existing().email == request.auth.token.email)
      );
      allow list: if isBootstrappedAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid) ||
        (isVerifiedUser() && resource.data.email == request.auth.token.email);
      allow create: if isVerifiedUser() && isValidId(userId) &&
        isValidUserPrivateProfile(incoming(), userId) &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time && (
          (isOwner(userId) &&
            incoming().role == 'player' &&
            incoming().email == request.auth.token.email &&
            (!('firebase_uid' in incoming()) || incoming().firebase_uid == request.auth.uid) &&
            (!('is_blocked' in incoming()) || incoming().is_blocked == 0) &&
            (!('wallet_balance' in incoming()) || incoming().wallet_balance == 0) &&
            (!('pending_withdrawal' in incoming()) || incoming().pending_withdrawal == 0) &&
            (!('total_deposited' in incoming()) || incoming().total_deposited == 0) &&
            (!('total_withdrawn' in incoming()) || incoming().total_withdrawn == 0) &&
            (!('total_won' in incoming()) || incoming().total_won == 0) &&
            (!('matches_played' in incoming()) || incoming().matches_played == 0) &&
            (!('wins' in incoming()) || incoming().wins == 0) &&
            (!('kills' in incoming()) || incoming().kills == 0) &&
            (!('points' in incoming()) || incoming().points == 0)) ||
          (isAdmin() && (incoming().role == 'player' || isBootstrappedAdmin()))
        );
      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidUserPrivateProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time && (
          // Action 1: Admin full operational update (approvals, balance adjustments, stats, role)
          (isAdmin() &&
            (incoming().role == existing().role || isBootstrappedAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sqlite_id', 'firebase_uid', 'username', 'phone', 'avatar_url', 'role', 'is_blocked',
              'wallet_balance', 'pending_withdrawal', 'total_deposited', 'total_withdrawn',
              'total_won', 'matches_played', 'wins', 'kills', 'points', 'updated_at'
            ])) ||
          // Action 2: Owner profile-only update (never touches wallet or stats)
          (isOwner(userId) &&
            incoming().role == existing().role &&
            (!('firebase_uid' in incoming()) || incoming().firebase_uid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sqlite_id', 'firebase_uid', 'username', 'phone', 'avatar_url', 'updated_at'
            ])) ||
          // Action 3: Owner spend-only debit (tournament entry fee or P2P send) - cannot increase wallet_balance
          (isOwner(userId) &&
            incoming().role == existing().role &&
            'wallet_balance' in incoming() &&
            (!('is_blocked' in existing()) || existing().is_blocked == 0) &&
            (!('wallet_balance' in existing()) ? 0 : existing().wallet_balance) >= incoming().wallet_balance &&
            incoming().wallet_balance >= (!('pending_withdrawal' in existing()) ? 0 : existing().pending_withdrawal) &&
            (!('matches_played' in incoming()) || incoming().matches_played <= ((!('matches_played' in existing()) ? 0 : existing().matches_played) + 1)) &&
            (!('points' in incoming()) || incoming().points <= ((!('points' in existing()) ? 0 : existing().points) + 10)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'wallet_balance', 'matches_played', 'points', 'updated_at'
            ])) ||
          // Action 4: Owner withdrawal hold lock (increases pending_withdrawal only up to available balance)
          (isOwner(userId) &&
            incoming().role == existing().role &&
            'pending_withdrawal' in incoming() &&
            (!('is_blocked' in existing()) || existing().is_blocked == 0) &&
            incoming().pending_withdrawal >= (!('pending_withdrawal' in existing()) ? 0 : existing().pending_withdrawal) &&
            incoming().pending_withdrawal <= (!('wallet_balance' in existing()) ? 0 : existing().wallet_balance) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pending_withdrawal', 'updated_at'])) ||
          // Action 5: Owner Daily Lucky Draw claim (max PKR 50 once per 20h)
          (isOwner(userId) &&
            incoming().role == existing().role &&
            'wallet_balance' in incoming() &&
            'last_lucky_draw_pkt' in incoming() &&
            'last_lucky_draw_at' in incoming() &&
            (!('is_blocked' in existing()) || existing().is_blocked == 0) &&
            (!('last_lucky_draw_at' in existing()) || request.time >= existing().last_lucky_draw_at + duration.value(20, 'h')) &&
            incoming().last_lucky_draw_at == request.time &&
            (!('last_lucky_draw_pkt' in existing()) || incoming().last_lucky_draw_pkt != existing().last_lucky_draw_pkt) &&
            incoming().wallet_balance >= (!('wallet_balance' in existing()) ? 0 : existing().wallet_balance) &&
            incoming().wallet_balance <= ((!('wallet_balance' in existing()) ? 0 : existing().wallet_balance) + 50) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'wallet_balance', 'last_lucky_draw_pkt', 'last_lucky_draw_at', 'updated_at'
            ])) ||
          // Action 6: Atomic P2P credit to recipient backed by equal debit from sender's own wallet
          (userId != request.auth.uid &&
            incoming().role == existing().role &&
            'wallet_balance' in incoming() &&
            (!('is_blocked' in existing()) || existing().is_blocked == 0) &&
            incoming().wallet_balance > (!('wallet_balance' in existing()) ? 0 : existing().wallet_balance) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['wallet_balance', 'updated_at']) &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance ==
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance -
              (incoming().wallet_balance - (!('wallet_balance' in existing()) ? 0 : existing().wallet_balance)))
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin() &&
        userId != request.auth.uid && existing().email != 'zeeshanjan21khankoko@gmail.com';
    }

    // Permanent Deposit Records
    match /deposits/{depositId} {
      allow get: if isSignedIn() && isValidId(depositId) && (existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(depositId) &&
        isValidDeposit(incoming(), depositId) &&
        incoming().created_at == request.time && (
          (incoming().user_uid == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().admin_note == '') ||
          isAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(depositId) &&
        isValidDeposit(incoming(), depositId) &&
        isAdmin() &&
        incoming().deposit_key == existing().deposit_key &&
        incoming().user_uid == existing().user_uid &&
        incoming().amount == existing().amount &&
        incoming().transaction_ref == existing().transaction_ref &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id', 'status', 'admin_note', 'tx_code', 'reviewed_at'
        ]);
      allow delete: if false;
    }

    // Permanent Withdrawal Records
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(withdrawalId) &&
        isValidWithdrawal(incoming(), withdrawalId) &&
        incoming().created_at == request.time && (
          (incoming().user_uid == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().admin_note == '') ||
          isAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(withdrawalId) &&
        isValidWithdrawal(incoming(), withdrawalId) &&
        isAdmin() &&
        incoming().withdrawal_key == existing().withdrawal_key &&
        incoming().user_uid == existing().user_uid &&
        incoming().amount == existing().amount &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id', 'status', 'admin_note', 'tx_code', 'reviewed_at'
        ]);
      allow delete: if false;
    }

    // Permanent Wallet Transaction Ledger
    match /transactions/{txCode} {
      allow get: if isSignedIn() && isValidId(txCode) && (existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(txCode) &&
        isValidLedgerTransaction(incoming(), txCode) &&
        incoming().created_at == request.time && (
          isAdmin() ||
          (incoming().user_uid == request.auth.uid && (
            (incoming().type in ['deposit', 'withdrawal'] && incoming().status == 'pending') ||
            (incoming().type in ['entry_fee', 'transfer_out'] && incoming().direction == 'debit' && incoming().status == 'completed') ||
            (incoming().type == 'lucky_draw' && incoming().direction == 'credit' && incoming().amount <= 50 && incoming().status == 'completed')
          )) ||
          (incoming().type == 'transfer_in' &&
            incoming().direction == 'credit' &&
            incoming().status == 'completed' &&
            incoming().user_uid != request.auth.uid &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance ==
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance - incoming().amount &&
            getAfter(/databases/$(database)/documents/users/$(incoming().user_uid)).data.wallet_balance ==
              get(/databases/$(database)/documents/users/$(incoming().user_uid)).data.wallet_balance + incoming().amount)
        );
      allow update: if isVerifiedUser() && isValidId(txCode) &&
        isValidLedgerTransaction(incoming(), txCode) &&
        isAdmin() &&
        incoming().tx_code == existing().tx_code &&
        incoming().user_uid == existing().user_uid &&
        incoming().type == existing().type &&
        incoming().amount == existing().amount &&
        incoming().direction == existing().direction &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id', 'status', 'balance_after', 'description', 'reference_id'
        ]);
      allow delete: if false;
    }

    // Daily Lucky Draw Claims
    match /lucky_draws/{drawKey} {
      allow get: if isSignedIn() && isValidId(drawKey) && (existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(drawKey) &&
        isValidLuckyDrawEntry(incoming(), drawKey) &&
        incoming().created_at == request.time && (
          (incoming().user_uid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.last_lucky_draw_pkt == incoming().draw_date_pkt &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.last_lucky_draw_at == request.time) ||
          isAdmin()
        );
      allow update, delete: if false;
    }

    // Team / Squad Registrations
    match /team_registrations/{regCode} {
      allow get: if isSignedIn() && isValidId(regCode) && (existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(regCode) &&
        isValidTeamRegistration(incoming(), regCode) &&
        incoming().created_at == request.time && (
          (incoming().user_uid == request.auth.uid && incoming().status == 'pending') ||
          isAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(regCode) &&
        isValidTeamRegistration(incoming(), regCode) &&
        isAdmin() &&
        incoming().registration_code == existing().registration_code &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['id', 'status', 'user_uid', 'sqlite_user_id']);
      allow delete: if isVerifiedUser() && isValidId(regCode) && isAdmin();
    }

    // Tournaments: Public read catalog (no PII/secrets); Admin writes + atomic player slot increment on join
    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(tournamentId) &&
        isValidTournament(incoming()) &&
        incoming().created_by_uid == request.auth.uid &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(tournamentId) &&
        isValidTournament(incoming()) &&
        incoming().id == existing().id &&
        incoming().created_by_uid == existing().created_by_uid &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'game_name', 'mode', 'entry_fee', 'prize_pool',
              'prize_1st', 'prize_2nd', 'prize_3rd', 'prize_4th', 'prize_5th',
              'max_slots', 'filled_slots', 'match_time', 'end_time', 'status',
              'banner_url', 'rules', 'winners', 'updated_at'
            ])) ||
          (existing().status in ['upcoming', 'live'] &&
            incoming().filled_slots == existing().filled_slots + 1 &&
            incoming().filled_slots <= existing().max_slots &&
            incoming().diff(existing()).affectedKeys().hasOnly(['filled_slots', 'updated_at']) &&
            !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/registrations/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/registrations/$(request.auth.uid)))
        );
      allow delete: if isVerifiedUser() && isValidId(tournamentId) && isAdmin();

      // Room secrets: only Admin or registered players of the parent tournament
      match /secrets/{secretId} {
        allow get: if isSignedIn() && isValidId(tournamentId) && isValidId(secretId) &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) && (
            isAdmin() || (
              isVerifiedUser() &&
              exists(/databases/$(database)/documents/tournaments/$(tournamentId)/registrations/$(request.auth.uid))
            )
          );
        allow list: if isBootstrappedAdmin();
        allow create, update: if isVerifiedUser() && isValidId(tournamentId) && isValidId(secretId) &&
          isValidTournamentSecret(incoming()) &&
          incoming().updated_at == request.time &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          isAdmin();
        allow delete: if isVerifiedUser() && isValidId(tournamentId) && isValidId(secretId) && isAdmin();
      }

      // Participant registrations: permanent once joined; only Admin can modify or remove
      match /registrations/{userId} {
        allow get: if isSignedIn() && isValidId(tournamentId) && isValidId(userId) &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          (isOwner(userId) || isAdmin());
        allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(tournamentId) && isValidId(userId) &&
          isValidTournamentRegistration(incoming(), userId) &&
          incoming().registered_at == request.time &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) && (
            isAdmin() ||
            (isOwner(userId) &&
              incoming().status == 'registered' &&
              get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status in ['upcoming', 'live'] &&
              getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)).data.filled_slots ==
                get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.filled_slots + 1 &&
              (get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.entry_fee == 0 ||
                getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance ==
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet_balance -
                  get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.entry_fee))
          );
        allow update: if isVerifiedUser() && isValidId(tournamentId) && isValidId(userId) &&
          isValidTournamentRegistration(incoming(), userId) &&
          incoming().user_uid == existing().user_uid &&
          incoming().registered_at == existing().registered_at &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'tournament_id', 'sqlite_user_id', 'player_id', 'username', 'in_game_name', 'in_game_id', 'slot_number', 'status'
          ]) &&
          isAdmin();
        allow delete: if isVerifiedUser() && isValidId(tournamentId) && isValidId(userId) && isAdmin();
      }
    }

    // Collection-group access for hydrating a user's own permanent registrations (and admin backup sync)
    match /{path=**}/registrations/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || existing().user_uid == request.auth.uid || isAdmin());
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.user_uid == request.auth.uid);
    }

    // Announcements: Public read, Admin-only write
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().created_by_uid == request.auth.uid &&
        incoming().created_at == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().id == existing().id &&
        incoming().created_by_uid == existing().created_by_uid &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content', 'is_pinned']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(announcementId) && isAdmin();
    }

    // Permanent policies: readable as single doc, writable only by bootstrapped Admin with strict lock flags
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isBootstrappedAdmin() && isValidId(settingId) && (
        (settingId == 'user_policy' && isValidAppUserPolicy(incoming())) ||
        (settingId != 'user_policy' && isValidAppTournamentPolicy(incoming()))
      ) &&
        incoming().updated_by_uid == request.auth.uid &&
        incoming().updated_at == request.time;
      allow delete: if false;
    }
  }
}
